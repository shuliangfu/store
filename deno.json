{
  "name": "@dreamer/store",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./react": "./src/react.ts",
    "./preact": "./src/preact.ts",
    "./view": "./src/view.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**"
    ]
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@dreamer/view": "jsr:@dreamer/view@^2.2.0",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "react": "npm:react@19.2.4",
    "react-dom/client": "npm:react-dom@19.2.4/client",
    "preact": "npm:preact@^10.29.2"
  },
  "tasks": {
    "test": "deno test -A --minimum-dependency-age=0 --no-check tests/",
    "test:node": "node --import tsx --test-force-exit test-node.mjs"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "0",
  "tests": {
    "include": [
      "tests/**/*.ts"
    ]
  }
}
